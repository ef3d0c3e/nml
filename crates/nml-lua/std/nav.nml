:: **Navigation menu**: `:nav` lists the workspace's pages, grouped by category. It is made
:: when the page is linked, so it follows pages as they are added, removed or renamed.
::
:: ```nml
:: :import std.nav
::
:: :nav
:: ```
::
:: A page sets where it appears with exported variables:
::
:: * `nav.category`: its group. Pages without one come first.
:: * `nav.order`: a number, to order the pages of a group; then by title.
:: * `nav.title`: shown instead of the page's title.
::
:: ```nml
:: :export nav.category = Guides
:: :export nav.order = 2
:: ```
::
:: The menu is a `<nav class="nav">` list; the current page's item has the class `current`,
:: and a group's item the class `category`.

:lua
```
function menu()
	local groups, names = {}, {}
	for _, page in ipairs(nml.pages()) do
		local category = page.variables["nav.category"] or ""
		if not groups[category] then
			groups[category] = {}
			table.insert(names, category)
		end
		table.insert(groups[category], page)
	end
	table.sort(names)
	local function order(page)
		return tonumber(page.variables["nav.order"]) or math.huge
	end
	local items = {}
	for _, name in ipairs(names) do
		local pages = groups[name]
		table.sort(pages, function(a, b)
			if order(a) ~= order(b) then return order(a) < order(b) end
			return a.title < b.title
		end)
		local links = {}
		for _, page in ipairs(pages) do
			local title = page.variables["nav.title"] or page.title
			table.insert(links, nml.element("list_item", {
				classes = page.current and { "current" } or nil,
				nml.element("link", { url = page.url, title }),
			}))
		end
		if name == "" then
			for _, link in ipairs(links) do table.insert(items, link) end
		else
			table.insert(items, nml.element("list_item", {
				classes = { "category" },
				name,
				nml.element("list", links),
			}))
		end
	end
	return {
		nml.element("raw", { content = '<nav class="nav">', block = true }),
		nml.element("list", items),
		nml.element("raw", { content = "</nav>", block = true }),
	}
end

nml.rule {
	name = "nav",
	atoms = { nml.line_start, nml.capture("command", ":nav", "keyword"), nml.line_end },
	handler = function(m, out)
		out:add(nml.defer("std.nav", "menu"))
	end,
	doc = "**Navigation menu** of the workspace's pages, by `nav.category`, `nav.order` and "
		.. "`nav.title`.",
	snippet = ":nav",
}
```
